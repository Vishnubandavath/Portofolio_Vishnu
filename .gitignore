# ==========================================
# .gitignore - Web Portfolio Security & Cleanup
# Ensures confidential, temporary, and system files remain private
# ==========================================

# --- Environment Variables & Secrets (CRITICAL) ---
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# --- Credentials, Keys & Certificates ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
*secret*
*token*
*credential*
credentials.json
client_secret*.json
service-account*.json
auth.json
*.id_rsa*

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- IDEs & Code Editors ---
.vscode/
!.vscode/launch.json.example
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.orig

# --- Dependencies & Package Managers ---
node_modules/
jspm_packages/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build, Distribution & Cache ---
dist/
build/
out/
.cache/
.parcel-cache/
*.tsbuildinfo

# --- Logs & Temporary Files ---
logs/
*.log
temp/
tmp/
*.tmp
*.bak
*.backup
*.old

# --- Python & Environment Artifacts ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
