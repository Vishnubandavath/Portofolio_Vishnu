# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and not touched by CRLF
*.html text
*.css text
*.js text
*.json text
*.md text
*.yml text
*.yaml text

# Declare binary files to prevent corruption during checkout/commit
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
